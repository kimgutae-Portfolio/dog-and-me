NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Production: live / Preview and local: test
STRIPE_MODE=test
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="WAN MEMORY <info@wanmemory.com>"
SITE_ORIGIN=https://www.wanmemory.com

# Admin browser push notifications. Keep the private key server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@wanmemory.com"
# Optional: restrict notifications to one admin profile UUID. Leave blank to notify all admins.
ADMIN_PUSH_TARGET_USER_ID=

# Set to 1 only in the operator local environment to enable /api/admin/render
WM_LOCAL_RENDER=

# Set to 1 only after verifying CSP causes no console violations.
CSP_ENFORCE=
